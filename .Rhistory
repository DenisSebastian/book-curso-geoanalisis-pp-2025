sii_LC <- st_read("data/sii/sii_urbe_LC.shp")
las_condes_mz <- st_read("data/shape/icv_las_condes.shp", quiet=T)
if (st_crs(las_condes_mz) != st_crs(sii_LC)) {
sii_LC <- st_transform(sii_LC, st_crs(las_condes_mz))
}
intersecciones <- st_intersects(las_condes_mz, sii_LC)
intersecciones
# Ejemplo: ver qué puntos están en el primer polígono
puntos_en_primero <- sii_LC[intersecciones[[1]], ]
puntos_en_primero
plot(st_geometry(las_condes_mz[1, ]), col = "lightblue")
plot(st_geometry(puntos_en_primero), col = "red", add = TRUE)
plot(st_geometry(las_condes_mz[1:10, ]), col = "lightblue")
plot(st_geometry(puntos_en_primero), col = "red", add = TRUE)
plot(st_geometry(las_condes_mz), col = "lightblue")
plot(st_geometry(puntos_en_primero), col = "red", add = TRUE)
# st_contains retorna TRUE solo si el punto está estrictamente dentro del polígono
contenidos <- st_contains(las_condes_mz, sii_LC)
# Ejemplo: puntos estrictamente contenidos en el primer polígono
puntos_contenidos <- sii_LC[contenidos[[1]], ]
# Graficar para comparar con el intersect
plot(st_geometry(las_condes_mz[1, ]), col = "lightgreen")
plot(st_geometry(puntos_contenidos), col = "blue", add = TRUE)
# Verificamos el CRS y lo igualamos si es necesario
if (st_crs(las_condes_mz) != st_crs(sii_LC)) {
sii_LC <- st_transform(sii_LC, st_crs(las_condes_mz))
}
las_condes_con_puntos <- las_condes_mz %>%
filter(lengths(st_contains(., sii_LC)) > 0)
plot(las_condes_con_puntos)
plot(las_condes_con_puntos$geometry)
