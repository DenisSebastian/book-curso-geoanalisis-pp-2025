hist(mz_area, breaks = 100,
main = "Manzanas entre 1 y 10 hectáreas cuandradas",
xlab = "Área (hec²)", ylab = "Frecuencia",
col = "orange", border = "orange")
ggplot(data, aes(x = n_com, y = vivienda)) +
geom_boxplot() +
labs(title = "Distribución del área de manzanas por comuna")
com_norte <- tbl_sii %>%
