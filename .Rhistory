com_norte <- tbl_sii %>%
filter(n_com %in% c("IQUIQUE", "ALTO HOSPICIO"))
boxplot(x = AREA ~ n_com, data = com_norte)
outliers <- com_norte %>%
group_by(n_com) %>%
mutate(
Q1 = quantile(AREA, 0.25, na.rm = TRUE),
Q3 = quantile(AREA, 0.75, na.rm = TRUE),
IQR = Q3 - Q1,
outlier = AREA < (Q1 - 1.5 * IQR) | AREA > (Q3 + 1.5 * IQR)
) %>%
filter(outlier) %>%
select(n_com, AREA)
print(outliers)
outliers <- com_norte %>%
group_by(n_com) %>%
mutate(
Q1 = quantile(AREA, 0.25, na.rm = TRUE),
