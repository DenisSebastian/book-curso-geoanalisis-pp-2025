library(gstat)
library(dplyr)
library(sf)
# pts_mp_stgo: sf con columna pm25_win y CRS en metros
stopifnot("pm25_win" %in% names(pts_mp_stgo), !sf::st_is_longlat(pts_mp_stgo))
loo_idw_once <- function(pts_sf, value = "pm25_win", p = 2, nmax = 8) {
f <- stats::as.formula(paste(value, "~ 1"))
cv <- gstat::krige.cv(f, pts_sf, nmax = nmax, set = list(idp = p))
# cv$residual = observado - predicho
out <- tibble(
p = p, nmax = nmax,
rmse = sqrt(mean(cv$residual^2, na.rm = TRUE)),
mae  = mean(abs(cv$residual), na.rm = TRUE),
me   = mean(cv$residual, na.rm = TRUE),
n    = nrow(cv),
y_mean = mean(cv$observed, na.rm = TRUE),
nrmse_mean = rmse / y_mean
)
return(out)
}
# ejemplo con p=2, nmax=8
loo_idw_once(pts_mp_stgo, "pm25_win", p = 2, nmax = 8)
library(purrr)
params <- expand.grid(p = c(1, 1.5, 2, 2.5, 3),
nmax = c(5, 8, 12),
KEEP.OUT.ATTRS = FALSE)
res <- pmap_dfr(params, ~ loo_idw_once(pts_mp_stgo, "pm25_win", p = ..1, nmax = ..2)) %>%
arrange(rmse, abs(me))
res  # tabla ordenada por rmse asc
res %>% slice(1)  # tu configuración recomendada
out_dir <-  "data/contaminacion"
# Guardar raster GeoTIFF
writeRaster(r_idw_masked,
filename = file.path(out_dir, "idw_pm25_las_condes.tif"),
overwrite = TRUE)
# También puedes guardar la versión completa (sin recorte)
writeRaster(r_idw,
filename = file.path(out_dir, "idw_pm25_rm.tif"),
overwrite = TRUE)
# Shapefile (para compatibilidad antigua)
st_write(mz_comuna,
dsn = file.path(out_dir, "indicador_pm25_las_condes.shp"),
delete_layer = TRUE)
out_dir <-  "data/contaminacion"
# Guardar raster GeoTIFF
writeRaster(r_idw_masked,
filename = file.path(out_dir, "idw_pm25_las_condes.tif"),
overwrite = TRUE)
