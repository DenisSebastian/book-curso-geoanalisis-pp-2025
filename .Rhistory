IQR = Q3 - Q1,
outlier = AREA < (Q1 - 1.5 * IQR) | AREA > (Q3 + 1.5 * IQR)
)
outliers
# Eliminar filas donde outlier es TRUE
com_norte_sin_outliers <- com_norte %>% filter(!outlier)
