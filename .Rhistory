?kde
# 4.1 Data frame para ggplot
kde_df <- raster::as.data.frame(kde_raster, xy = TRUE) %>%
rename(kde = layer)
# 4.2 Umbral por percentil (p.ej., 85%)
p_cut  <- stats::quantile(kde_df$kde, 0.85, na.rm = TRUE)
kde_df <- kde_df %>% mutate(kde_plot = ifelse(kde < p_cut, NA, kde))
# 4.3 Mapa
kde_map <- ggplot() +
geom_raster(data = kde_df, aes(x = x, y = y, fill = kde_plot)) +
scale_fill_viridis(option = "magma", na.value = NA, name = "KDE") +
coord_equal() +
labs(title = "KDE de delitos violentos", subtitle = "Celdas ≥ P85") +
theme_bw()
kde_map
