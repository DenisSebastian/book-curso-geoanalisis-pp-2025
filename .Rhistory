mapview(pts_comuna_sii, zcol = "mp2_5", color = "gray",
col.regions = pal_atractor, cex =3)
mapview(pts_comuna_sii, zcol = "pm25_win", color = "gray",
col.regions = pal_atractor, cex =3)
# Puntos sf se ajusta a coordenadas planas utm19S
if (sf::st_is_longlat(pts_mp_stgo)) {
pts_mp_stgo <- st_transform(pts_mp_stgo, 32719)
}
# Convertir a SpatVector (terra)
pts_v <- vect(pts_comuna_sii)
rm(pts_comuna_sii)
# Convertir a SpatVector (terra)
pts_v <- vect(pts_comuna_sii)
# Definir raster plantilla (resolución y extensión)
r <- rast(ext(pts_v), resolution = 100, crs = crs(pts_v))  # 100 m
# Convertir centro de celdas a sf de puntos para predecir con gstat
centros <- as.points(r)                # SpatVector puntos
centros_sf <- st_as_sf(centros)        # a sf
# IDW con gstat
idw_fit <- gstat::gstat(formula = pm25_win ~ 1,
data = st_as_sf(pts_v),
nmax = 8, set = list(idp = 2))
# guardar la predicción
pred <- predict(idw_fit, newdata = centros_sf)  # 'var1.pred'
centros_sf$pred <- pred$var1.pred
r_idw <- rasterize(vect(centros_sf), r, field = "pred")
names(r_idw) <- "imp"
names(r_idw) <- "imp2.5"
r_idw_masked <- mask(r_idw, mask = comuna_border %>% vect())
r_idw_masked
mapview(r_idw_masked, zcol = "idw_atractor", col.regions = pal_atractor)
mapview(r_idw, zcol = "idw_atractor", col.regions = pal_atractor)
